{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/winauto/workflow.schema.json",
  "title": "WinAuto workflow v1.0",
  "description": "仅用于文档和编辑器提示。语义规则（别名引用、步骤 id 唯一、高风险快捷键、坐标范围等）以 C++ WorkflowValidator 为准，二者不一致时以 C++ 为准。",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "windows",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "windows": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "$ref": "#/definitions/window"
      }
    },
    "execution": {
      "$ref": "#/definitions/execution"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/step"
      }
    }
  },
  "definitions": {
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "failurePolicy": {
      "enum": [
        "stop",
        "continue"
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "times": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "processName"
          ],
          "properties": {
            "processName": {
              "minLength": 1
            }
          }
        },
        {
          "required": [
            "titleContains"
          ],
          "properties": {
            "titleContains": {
              "minLength": 1
            }
          }
        }
      ],
      "properties": {
        "processName": {
          "type": "string"
        },
        "titleContains": {
          "type": "string"
        },
        "timeoutMs": {
          "$ref": "#/definitions/timeoutMs"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stepTimeoutMs": {
          "$ref": "#/definitions/timeoutMs"
        },
        "onFailure": {
          "$ref": "#/definitions/failurePolicy"
        },
        "screenshotOnFailure": {
          "type": "boolean"
        },
        "retry": {
          "$ref": "#/definitions/retry"
        },
        "maxStepExecutions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "description": "整个运行最多执行多少次步骤，缺省 10000"
        }
      }
    },
    "uiaLocator": {
      "type": "object",
      "required": [
        "strategy"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "automationId"
          ]
        },
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "controlType"
          ]
        }
      ],
      "properties": {
        "strategy": {
          "const": "uia"
        },
        "automationId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "controlType": {
          "type": "string"
        },
        "match": {
          "enum": [
            "exact",
            "contains"
          ]
        },
        "ambiguity": {
          "enum": [
            "error",
            "first"
          ]
        }
      }
    },
    "windowPointLocator": {
      "type": "object",
      "required": [
        "strategy",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "window_point"
        },
        "x": {
          "type": "number",
          "minimum": 0
        },
        "y": {
          "type": "number",
          "minimum": 0
        },
        "anchor": {
          "enum": [
            "top_left",
            "bottom_right",
            "ratio"
          ]
        }
      }
    },
    "screenPointLocator": {
      "type": "object",
      "required": [
        "strategy",
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "screen_point"
        },
        "x": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        },
        "y": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      }
    },
    "imageLocator": {
      "type": "object",
      "required": [
        "strategy",
        "template"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "image"
        },
        "template": {
          "type": "string",
          "minLength": 1
        },
        "minConfidence": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "ambiguity": {
          "enum": [
            "error",
            "first"
          ]
        },
        "searchRegion": {
          "type": "object",
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "integer"
            },
            "y": {
              "type": "integer"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "leafLocator": {
      "oneOf": [
        {
          "$ref": "#/definitions/uiaLocator"
        },
        {
          "$ref": "#/definitions/windowPointLocator"
        },
        {
          "$ref": "#/definitions/screenPointLocator"
        },
        {
          "$ref": "#/definitions/imageLocator"
        }
      ]
    },
    "fallbackLocator": {
      "type": "object",
      "required": [
        "strategy",
        "locators"
      ],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "const": "fallback"
        },
        "locators": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/leafLocator"
          }
        }
      }
    },
    "locator": {
      "oneOf": [
        {
          "$ref": "#/definitions/uiaLocator"
        },
        {
          "$ref": "#/definitions/windowPointLocator"
        },
        {
          "$ref": "#/definitions/screenPointLocator"
        },
        {
          "$ref": "#/definitions/imageLocator"
        },
        {
          "$ref": "#/definitions/fallbackLocator"
        }
      ]
    },
    "expect": {
      "type": "object",
      "required": [
        "type",
        "locator"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "element_exists"
        },
        "locator": {
          "$ref": "#/definitions/locator"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "activate_window",
            "click",
            "mouse_move",
            "mouse_click",
            "set_value",
            "input_text",
            "hotkey",
            "wait",
            "wait_for_element",
            "assert_element",
            "if",
            "repeat",
            "while"
          ]
        },
        "window": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/definitions/locator"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "textFrom": {
          "const": "prompt"
        },
        "method": {
          "enum": [
            "unicode",
            "clipboard"
          ]
        },
        "sensitive": {
          "type": "boolean"
        },
        "mode": {
          "enum": [
            "auto",
            "point"
          ]
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "timeoutMs": {
          "$ref": "#/definitions/timeoutMs"
        },
        "expect": {
          "$ref": "#/definitions/expect"
        },
        "retry": {
          "$ref": "#/definitions/retry"
        },
        "onFailure": {
          "$ref": "#/definitions/failurePolicy"
        },
        "condition": {
          "type": "object",
          "required": [
            "locator"
          ],
          "additionalProperties": false,
          "description": "if / while 的条件。element_exists：控件存在时成立；element_missing：控件不存在时成立。timeoutMs>0 时最多等这么久让条件成立（缺省只检查一次）。",
          "properties": {
            "type": {
              "enum": [
                "element_exists",
                "element_missing"
              ]
            },
            "locator": {
              "$ref": "#/definitions/locator"
            }
          }
        },
        "times": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "repeat 的次数"
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "description": "while 的硬上限；跑满后条件仍成立则失败（LimitExceeded）"
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000,
          "description": "循环每轮之间的间隔，缺省 100"
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          },
          "description": "if 条件成立时执行"
        },
        "else": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          },
          "description": "if 条件不成立时执行"
        },
        "body": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          },
          "description": "repeat / while 的循环体"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "wait"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "durationMs"
            ]
          },
          "else": {
            "if": {
              "properties": {
                "type": {
                  "const": "repeat"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "times",
                "body"
              ]
            },
            "else": {
              "required": [
                "window"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "click",
                  "mouse_move",
                  "mouse_click",
                  "set_value",
                  "wait_for_element",
                  "assert_element"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "locator"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "hotkey"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "keys"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "input_text",
                  "set_value"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "oneOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "textFrom"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "if",
                  "while"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "condition"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "if"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "then"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "while"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "maxIterations",
              "body"
            ]
          }
        }
      ]
    }
  }
}
