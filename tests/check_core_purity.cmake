# 用法：cmake -DCORE_DIR=<path> -P check_core_purity.cmake
# core/ 必须保持平台无关：不得包含 Win32、COM、UIA、Qt 的头文件。
file(GLOB_RECURSE files "${CORE_DIR}/*.h" "${CORE_DIR}/*.cpp" "${CORE_DIR}/*.hpp")
set(forbidden_regex "#[ \t]*include[ \t]*[<\"](windows\\.h|Windows\\.h|winuser\\.h|comdef\\.h|comip\\.h|atlbase\\.h|UIAutomation[A-Za-z]*\\.h|objbase\\.h|shellapi\\.h|psapi\\.h|tlhelp32\\.h|Q[A-Za-z]+|Qt[A-Za-z]+/)")
set(bad "")
foreach(f ${files})
    file(STRINGS "${f}" hits REGEX "${forbidden_regex}")
    if(hits)
        list(APPEND bad "${f}: ${hits}")
    endif()
endforeach()
list(LENGTH files n)
if(n EQUAL 0)
    message(FATAL_ERROR "no source files found under ${CORE_DIR}")
endif()
if(bad)
    string(REPLACE ";" "\n  " msg "${bad}")
    message(FATAL_ERROR "core/ must not depend on Win32/Qt headers:\n  ${msg}")
endif()
message(STATUS "core purity OK (${n} files checked)")
